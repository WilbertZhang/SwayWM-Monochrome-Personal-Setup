{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "display": {
        "separator": " 󰇙 ",
        "color": {
            "keys": "33", // Color gris acento (#949494, alacritty.normal.yellow)
            "title": "32" // Color carbón (#767676, alacritty.normal.green)
        }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "──────────────────────────────",
            "outputColor": "33"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "33"
        },
        {
            "type": "kernel",
            "key": "󰒋 Core",
            "keyColor": "33"
        },
        {
            "type": "uptime",
            "key": "󰔚 Uptime",
            "keyColor": "33"
        },
        {
            "type": "wm",
            "key": "󱂬 Window Manager",
            "keyColor": "33"
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal",
            "keyColor": "33"
        },
        {
            "type": "memory",
            "key": "󰘚 Memory",
            "keyColor": "33"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break",
        {
            "type": "custom",
            "format": "Love the Earth <3"
        },
        "break"
    ]
}
