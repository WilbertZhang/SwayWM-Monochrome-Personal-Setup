{
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 15,
    "margin-right": 15,
    "height": 34,
    "spacing": 10,
    "modules-left": ["custom/launcher", "sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "network", "bluetooth", "power-profiles-daemon", "pulseaudio", "battery", "tray"],

    "custom/launcher": {
        "format": "Apps",
        "on-click": "wofi --show drun",
        "tooltip": false
    },
    "sway/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "format": "{name}"
    },
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "󰃭  {:%A, %B %d}",
        "tooltip": false
    },
    "cpu": { "format": "  {usage}%" },
    "memory": { "format": "  {}%" },
    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰤮 Off",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": " {num_connections}",
        "tooltip-format": "{controller_alias}",
        "on-click": "blueman-manager"
    },
    "power-profiles-daemon": {
        "format": "{icon} {profile}",
        "tooltip-format": "Profile: {profile}",
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    }
}
